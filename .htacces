DirectoryIndex disabled
RewriteEngine On

# 1. Zorg dat de homepage (/) werkt en de index.html laadt
RewriteRule ^$ /index.html [L]

# 2. Verberg de .html extensie in de adresbalk (stuur /html/about-me.html naar /about-me)
RewriteCond %{THE_REQUEST} \s/+html/([^\s.?]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 3. Als iemand direct een .html bestand typt, stuur ze dan naar de schone URL
RewriteCond %{THE_REQUEST} \s/+([^\s.?]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 4. Bestaande bestanden en mappen (zoals je css, media en mailform.php) mogen gewoon laden
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 5. De magie: Als iemand /about-me typt, laad dan /html/about-me.html
RewriteCond %{DOCUMENT_ROOT}/html/$1.html -f
RewriteRule ^(.+?)/?$ /html/$1.html [L]